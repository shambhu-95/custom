<odoo>
    <template id="jitsi_meeting_template" name="Jitsi Meeting Website Page">
        <t t-call="website.layout">
            <div class="container my-5">
                <h2 class="text-center">Join Meeting: <t t-esc="meeting.name"/></h2>
                <div class="row justify-content-center mt-4">
                    <div class="col-12 col-lg-10">
                        <iframe t-att-src="meeting.meeting_url"
                                width="100%"
                                height="600"
                                allow="camera; microphone; fullscreen; display-capture"
                                frameborder="0">
                        </iframe>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
